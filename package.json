{
  "name": "shadcn-m3e",
  "version": "0.0.1",
  "private": true,
  "description": "Material 3 Expressive for shadcn/ui — React 19, Tailwind CSS v4, Base UI",
  "keywords": [
    "base-ui",
    "m3e",
    "material-3",
    "material-3-expressive",
    "material-design",
    "react",
    "shadcn",
    "shadcn-ui",
    "tailwindcss"
  ],
  "license": "MIT",
  "author": "Crysta1221",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd apps/docs dev",
    "build": "bun run --cwd apps/docs build",
    "preview": "bun run --cwd apps/docs preview",
    "dev:canvas": "bun run --cwd apps/canvas dev",
    "build:canvas": "bun run --cwd apps/canvas build",
    "deploy:canvas": "wrangler deploy --config apps/canvas/wrangler.jsonc",
    "typecheck": "bun run --cwd apps/docs typecheck",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "gen:tokens": "bun run --cwd packages/m3e gen:tokens",
    "check:icons": "bun run --cwd packages/m3e check:icons",
    "gen:icons": "bun run --cwd packages/m3e gen:icons",
    "registry:build": "bun run --cwd packages/m3e registry:build"
  },
  "devDependencies": {
    "oxlint-tailwindcss": "1.13.0",
    "typescript": "~6",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  }
}
