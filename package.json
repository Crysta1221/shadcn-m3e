{
  "name": "shadcn-m3e",
  "version": "0.0.1",
  "private": true,
  "description": "Material 3 Expressive for shadcn/ui — React 19, Tailwind CSS v4, Base UI",
  "keywords": [
    "base-ui",
    "m3e",
    "material-3",
    "material-3-expressive",
    "material-design",
    "react",
    "shadcn",
    "shadcn-ui",
    "tailwindcss"
  ],
  "license": "MIT",
  "author": "Crysta1221",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build",
    "preview": "vp preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "gen:tokens": "bun scripts/gen-tokens.ts",
    "check:icons": "node scripts/icons.mjs --check",
    "gen:icons": "node scripts/icons.mjs",
    "registry:build": "node scripts/build-registry.mjs",
    "predev": "node scripts/build-registry.mjs",
    "prebuild": "node scripts/build-registry.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@iconify/react": "^6.0.2",
    "@material/material-color-utilities": "^0.4.0",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-router": "^1.170.40",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "next-themes": "^0.4.6",
    "node-vibrant": "^4.0.4",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.1",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.41",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "oxlint-tailwindcss": "1.13.0",
    "typescript": "~6",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  }
}
