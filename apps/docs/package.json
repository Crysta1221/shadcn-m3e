    "@tanstack/highlight": "^1.0.0",
    "@tanstack/markdown": "^1.0.0",
    "@tanstack/react-router": "^1.170.40",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "recharts": "3.8.0",
    "shadcn": "^4.21.0",
