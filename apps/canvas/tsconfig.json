{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/components/m3e/*": ["../../packages/m3e/src/components/*"],
      "@/lib/m3e/*": ["../../packages/m3e/src/lib/*"],
      "@/hooks/*": ["../../packages/m3e/src/hooks/*"],
      "@/styles/*": ["../../packages/m3e/src/styles/*"],
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts"],
  "exclude": ["node_modules", "promo", "dist"]
}
